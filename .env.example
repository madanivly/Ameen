# ─── Vite Dev Server / Backend Port ─────────────────────────────
# Both the Vite proxy and backend/server.js read this variable.
# They must always match — change it here, not in two places.
VITE_BACKEND_PORT=8080

# ─── FTP Deploy (used by deploy.cjs) ───────────────────────────
# Set these in your real .env file (never commit real values).
FTP_HOST=198.251.81.49
FTP_USER=your-ftp-username
FTP_PASSWORD=your-ftp-password
FTP_SECURE=true

# ─── Backend Database (used by api/api.php on LiteSpeed host) ──
# These are set as PHP env vars on your cPanel host, NOT in .env files.
# They appear here only as documentation.
# DB_HOST=REPLACE_ME_DB_HOST
# DB_USER=REPLACE_ME_DB_USER
# DB_PASSWORD=REPLACE_ME_DB_PASSWORD
# DB_NAME=REPLACE_ME_DB_NAME
